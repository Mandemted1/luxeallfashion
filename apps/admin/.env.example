# Neon connection string — same database the storefront app uses.
# Neon dashboard → your project → Connection Details.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Random secret used to sign admin session tokens. Generate your own with:
#   openssl rand -base64 32
# Must be DIFFERENT from the storefront's BETTER_AUTH_SECRET — admin and
# customer sessions are fully separate and must never be interchangeable.
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3001"

# Resend dashboard → API Keys. Used for admin invite emails.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Cloudflare dashboard → R2 → Manage API Tokens. This app needs write
# access (it's the one generating presigned upload URLs for product/
# homepage images); the storefront app only needs the public URL below.
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="luxeallfashion-media"
# The custom domain the R2 bucket is connected to (needed for Cloudflare
# edge caching + no egress fees) — not the default r2.dev domain.
R2_PUBLIC_URL="https://media.luxeallfashion.com"
