# Neon connection string — same database the admin app uses.
# Neon dashboard → your project → Connection Details.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Random secret used to sign customer session tokens. Generate your own with:
#   openssl rand -base64 32
# Must be DIFFERENT from the admin app's BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Resend dashboard → API Keys. Used for order confirmation emails.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Paystack dashboard → Settings → API Keys & Webhooks.
# Use the test keys locally; live keys only ever go into Vercel's
# Production environment variables, never into a local .env file.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Same R2 bucket as the admin app, but only the public URL — the storefront
# reads/displays images, it never uploads, so it doesn't need R2 write
# credentials at all.
R2_PUBLIC_URL="https://media.luxeallfashion.com"
