# Neon dashboard → your project → Connect. Neon gives you two connection
# strings — you need both, they're different.

# Pooled connection (host contains "-pooler") — used at runtime by both apps.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"

# Direct (non-pooled) connection — used only for running migrations.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
