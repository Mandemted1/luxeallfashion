generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via PgBouncer) — what the app uses at runtime.
  // Serverless functions open lots of short-lived connections; pooling
  // keeps that from exhausting Postgres's connection limit.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection — migrations need this specifically,
  // they use features (advisory locks) that don't work through a pooler
  // in transaction mode.
  directUrl = env("DIRECT_URL")
}

// ---------- Admin / staff (apps/admin auth) ----------

enum AdminRole {
  OWNER
  STAFF
}

// An OWNER always has full access everywhere, unconditionally — these
// rows only ever apply to STAFF, and only cover the pages listed here.
// Dashboard is deliberately absent (every active admin can see it, it's
// read-only) and so is Team (OWNER-only in application code, since
// letting a STAFF admin manage other admins' permissions would let them
// escalate their own access).
enum AdminPage {
  ORDERS
  PRODUCTS
  INSTAGRAM_DRAFTS
  CUSTOMERS
  DISCOUNT_CODES
  MARKETING
  HOMEPAGE
}

// Specific mutating capabilities a STAFF admin can be granted, one level
// below page access — granting an action implies (and auto-grants) view
// access to that action's page, but not the reverse. Pages with no
// mutating actions of their own (Customers, Marketing) have none here;
// access to those is page-level only. Each value's prefix is its page,
// enforced by convention rather than a DB constraint since Prisma can't
// express "this enum value belongs to that enum value".
enum AdminAction {
  ORDERS_UPDATE_STATUS
  ORDERS_UNDO_STATUS
  PRODUCTS_CREATE
  PRODUCTS_EDIT
  PRODUCTS_DELETE
  PRODUCTS_TOGGLE_ACTIVE
  PRODUCTS_MANAGE_VARIANTS
  PRODUCTS_MANAGE_CATEGORIES
  INSTAGRAM_DRAFTS_SYNC
  INSTAGRAM_DRAFTS_REVIEW
  INSTAGRAM_DRAFTS_AI_SETTINGS
  DISCOUNT_CODES_CREATE
  DISCOUNT_CODES_TOGGLE_ACTIVE
  DISCOUNT_CODES_DELETE
  HOMEPAGE_EDIT_CONTENT
  HOMEPAGE_EDIT_TILES
  HOMEPAGE_EDIT_PROMO_BANNER
  HOMEPAGE_MANAGE_SOCIAL_LINKS
}

model AdminUser {
  id       String    @id @default(cuid())
  name     String
  // Kept in sync with AdminAuthUser.email by application code (e.g. in a
  // transaction) whenever it changes — Prisma can't enforce that across
  // two separate tables on its own.
  email    String    @unique
  role     AdminRole @default(STAFF)
  isActive Boolean   @default(true)

  // Credentials live on AdminAuthAccount, not here — Better-Auth owns
  // that. Null until the invite is accepted and the Better-Auth account
  // is actually created.
  authUserId String?        @unique
  authUser   AdminAuthUser? @relation(fields: [authUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesSent AdminInvite[]
  permissions AdminPermission[]
  actionGrants AdminActionGrant[]
}

// A missing row for a given page means no access to it at all (no nav
// entry, page redirects away) — only pages a STAFF admin has been
// explicitly granted get a row here.
model AdminPermission {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  page        AdminPage

  @@unique([adminUserId, page])
}

// A missing row for a given action means that specific mutation is
// blocked, even if the admin can view the page it lives on.
model AdminActionGrant {
  id          String      @id @default(cuid())
  adminUserId String
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      AdminAction

  @@unique([adminUserId, action])
}

// Not a Better-Auth primitive — this is our own invite-only admin signup
// flow, sitting on top of it: the OWNER creates an invite, Resend emails
// the link, and accepting it is what creates the real AdminUser account.
// There's no public admin registration; this is the only way in.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  role        AdminRole @default(STAFF)
  token       String    @unique
  invitedById String
  invitedBy   AdminUser @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  permissions  AdminInvitePermission[]
  actionGrants AdminInviteActionGrant[]
}

// Mirrors AdminPermission but scoped to a not-yet-accepted invite — the
// chosen pages are picked at invite time and copied over to real
// AdminPermission rows the moment the invite is accepted (see
// app/invite/[token]/actions.ts).
model AdminInvitePermission {
  id       String      @id @default(cuid())
  inviteId String
  invite   AdminInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  page     AdminPage

  @@unique([inviteId, page])
}

// Mirrors AdminActionGrant but scoped to a not-yet-accepted invite.
model AdminInviteActionGrant {
  id       String      @id @default(cuid())
  inviteId String
  invite   AdminInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  action   AdminAction

  @@unique([inviteId, action])
}

// ---------- Auth (Better-Auth) ----------
//
// Two fully separate identity namespaces — a customer session must never
// be valid on the admin subdomain, and vice versa. AdminUser/Customer
// above hold business data (role, isActive, marketingOptIn, orders...);
// the Admin*/Customer* tables below hold login identity and credentials
// only, and are linked back via authUserId. Generated with
// `npx @better-auth/cli generate` against apps/admin/src/lib/auth.ts and
// apps/storefront/src/lib/auth.ts respectively, then merged in here with
// friendlier relation field names — re-run the generator and diff against
// this if either auth.ts config ever changes (e.g. adding a plugin).

model AdminAuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adminUser AdminUser?
  sessions  AdminAuthSession[]
  accounts  AdminAuthAccount[]

  @@map("AdminAuthUser")
}

model AdminAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AdminAuthSession")
}

model AdminAuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AdminAuthAccount")
}

model AdminAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AdminAuthVerification")
}

model CustomerAuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer?
  sessions CustomerAuthSession[]
  accounts CustomerAuthAccount[]

  @@map("CustomerAuthUser")
}

model CustomerAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   CustomerAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("CustomerAuthSession")
}

model CustomerAuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   CustomerAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("CustomerAuthAccount")
}

model CustomerAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("CustomerAuthVerification")
}

// ---------- Catalog ----------

// The three sub-brands sold through the one shared storefront/cart/checkout.
// Kept separate from Category (what it is) so admin analytics can
// roll revenue, orders, and inventory up per brand (which store it's under).
enum Brand {
  OG_LUXEMEN
  CHICSTYLE
  KIDDIES_SPACE_GH
}

// Admin-defined and managed from the dashboard — not a fixed enum, so she
// can create/rename/delete categories herself with no code changes.
// Scoped to one of the three storefronts (Brand) — categories aren't
// shared across stores. She creates "under" a specific brand, e.g. OG
// Luxemen's "Shirts" is a separate row from a hypothetical Chicstyle
// "Shirts", not the same category reused across stores.
//
// Optional one-level parent/child nesting (parentId) -- added for Kiddies
// Space GH's Boys/Girls split, where each gender is a parent with its own
// Tops/Footwear/etc children. Other brands leave parentId null and stay a
// flat list. Only one level deep is supported (a child's own children
// aren't meaningful here and the admin UI doesn't offer them).
model Category {
  id        String   @id @default(cuid())
  brand     Brand
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryParent")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products                  Product[]
  instagramDraftSuggestions InstagramDraft[]

  @@unique([brand, parentId, slug])
  @@index([brand])
  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  material    String?
  // The manufacturer/designer, e.g. "ZARA" — unrelated to `brand` below,
  // which is which of the three stores this is sold under. Optional and
  // shown as a label above the product name wherever it's displayed.
  brandName   String?
  brand       Brand
  // Must reference a Category with the same brand — Prisma can't enforce
  // that at the schema level, so the admin's product form should only
  // offer categories matching the product's own brand.
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  isActive    Boolean  @default(true)
  // Admin-controlled, independent of brand/category — the storefront's
  // "New In" page shows only products with this on, not just recent ones.
  isNewIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Set instead of a real row delete when the product has order history —
  // OrderItem.productId is a required FK, so removing the row outright
  // would break past orders. A soft-deleted product is hidden everywhere
  // (forced inactive too) but the row stays so old orders still resolve.
  // Products with no order history are still hard-deleted; this is never
  // set for those.
  deletedAt   DateTime?

  variants   ProductVariant[]
  orderItems OrderItem[]
  // Set only if this product was created by approving an Instagram draft —
  // most products have no InstagramDraft at all (manually created, or the
  // catalog predates this pipeline).
  instagramDraft InstagramDraft?

  @@index([brand])
  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size      String // e.g. "M", "L", "XL", "2XL", "41".."46"
  colorName String
  colorHex  String
  sku       String @unique
  quantity  Int    @default(0)
  priceGhs  Int // stored in pesewas (minor unit) to avoid float math

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, colorName])
}

// ---------- Discounts ----------

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Editing an existing code's terms isn't offered in the admin UI on
// purpose — once a code may have been used on real orders, retroactively
// changing its value gets confusing. The flow is: deactivate old, add new.
model DiscountCode {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType
  value      Int // PERCENTAGE: 1-100. FIXED: pesewas.
  // Null = valid across all three stores. Set = scoped to one brand only.
  brand      Brand?
  isActive   Boolean      @default(true)
  usageLimit Int? // null = unlimited
  usageCount Int          @default(0)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders Order[]

  @@index([brand])
}

// ---------- Delivery ----------

model DeliveryRegion {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Greater Accra"
  slug      String   @unique // matches predefined region geometry on the map
  priceGhs  Int // stored in pesewas
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

// ---------- Customers & marketing ----------

// A Customer row is created on first checkout regardless of whether they
// create an account. authUserId stays null for guest checkouts; setting a
// password (at checkout or later) is what creates the CustomerAuthUser/
// CustomerAuthAccount pair and turns a guest into a full account with
// login + order history + saved addresses. Credentials live on
// CustomerAuthAccount, not here — Better-Auth owns that.
model Customer {
  id             String  @id @default(cuid())
  name           String
  // Kept in sync with CustomerAuthUser.email by application code whenever
  // it changes — Prisma can't enforce that across two separate tables.
  email          String  @unique
  phone          String  @unique
  marketingOptIn Boolean @default(false)

  authUserId String?           @unique
  authUser   CustomerAuthUser? @relation(fields: [authUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

model CustomerAddress {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label            String? // e.g. "Home", "Office"
  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  addressDetail    String
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

// ---------- Orders ----------

enum OrderStatus {
  PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          String @id @default(cuid())
  // Human-friendly identifier, e.g. "LUX-1000" (that prefix is applied in
  // application code, not stored) — separate from id since cuids aren't
  // fit for customer/WhatsApp-facing display or a Paystack reference.
  orderNumber Int    @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  deliveryAddress  String // free-text detail within the chosen region

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)

  subtotalGhs Int
  shippingGhs Int
  totalGhs    Int

  // Amount actually deducted at checkout, kept even if the code's own
  // terms change or it's deleted later — same "value at time of purchase"
  // pattern as OrderItem.priceGhs below.
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountGhs    Int           @default(0)

  paystackReference String? @unique

  // Random, unguessable — what /checkout/complete actually looks orders up
  // by, instead of the sequential orderNumber/paystackReference. Those are
  // fine as customer-facing labels (order emails, WhatsApp, admin) but were
  // never meant to double as an access key: anyone could page through
  // ?reference=LUX-1, LUX-2, ... and see every order ever placed. Nullable
  // only because existing orders predate this column; every order created
  // from here on always gets one (see checkout/actions.ts).
  confirmationToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusEvent[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int
  priceGhs Int // price at time of purchase, per unit
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// ---------- Homepage content (apps/admin: Homepage editor) ----------

enum HeroMode {
  VIDEO
  SLIDER
}

// Single row, always id "singleton" — enforced by application code, not the
// schema, since Prisma has no first-class "at most one row" constraint.
model HomepageContent {
  id                String   @id @default(cuid())
  heroMode          HeroMode @default(SLIDER)
  heroVideoUrl      String
  heroCtaLabel      String
  heroCtaHref       String
  newsletterHeading String
  // First-visit signup popup — admin-editable so they can add a discount
  // mention themselves later without a code change; no discount logic
  // lives here, it's just copy.
  popupEnabled      Boolean  @default(true)
  popupHeading      String   @default("Join the List")
  popupBody         String   @default("Sign up to hear about new arrivals and updates.")
  updatedAt         DateTime @updatedAt
}

// Emails captured from either the first-visit popup or the newsletter
// section already at the bottom of every page — same list either way,
// `source` just records which form it came through.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String
  createdAt DateTime @default(now())
}

// One per brand — created at seed time, never added to or removed from,
// just edited (title/CTA/image).
model HomepageTile {
  id           String @id @default(cuid())
  brand        Brand  @unique
  title        String
  ctaLabel     String
  href         String
  imageUrl     String
  // Background image for this brand's slide in the homepage hero slider —
  // separate from imageUrl above (the smaller collection-tile image further
  // down the page), so admin can pick different crops for each. Empty
  // string falls back to a neutral placeholder in the UI.
  heroImageUrl String @default("")
}

// One per brand — the thin promo strip at the top of each store's own page.
model PromoBanner {
  id       String  @id @default(cuid())
  brand    Brand   @unique
  message  String
  isActive Boolean @default(true)
}

// Freely add/remove — shown in the site footer.
model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Instagram catalog ingestion ----------

enum AiProvider {
  GEMINI
  OPENAI
  ANTHROPIC
}

// Single shared row (id always "singleton", same convention as
// HomepageContent) — which AI vision provider + key the Instagram
// ingestion pipeline currently uses. Editable from the admin dashboard so
// a provider can be swapped (outage, pricing, quota) without a redeploy.
// The key itself is never echoed back to the client once saved.
model AiIntegrationSettings {
  id        String     @id
  provider  AiProvider @default(GEMINI)
  apiKey    String?
  // Global on/off switch for the whole Instagram ingestion pipeline —
  // checked by runInstagramIngestion() itself, so it applies no matter
  // which entry point calls it (the cron's GitHub Actions script, a
  // manual dispatch from the admin UI, or a local run of the script).
  isPaused  Boolean    @default(false)
  updatedAt DateTime   @updatedAt
}

// QUEUED: discovered, not yet processed by AI. PENDING: processed,
// awaiting admin review. FAILED: exhausted its retry attempts — stays
// visible for the admin to retry or decline, rather than vanishing.
enum InstagramDraftStatus {
  QUEUED
  PENDING
  APPROVED
  REJECTED
  FAILED
}

// One row per Instagram post the ingestion pipeline has already seen —
// instagramPostId is how it avoids re-processing the same post on the
// next sync. A row is created QUEUED at discovery time (cheap, no AI
// call yet) and filled in by the worker once actually processed; images
// are only populated then too (never the original Instagram CDN URL,
// which expires — re-fetched fresh right before download).
model InstagramDraft {
  id              String                @id @default(cuid())
  instagramPostId String                @unique
  // Which store's Instagram account this came from — also the Brand the
  // product gets created under on approval.
  sourceAccount   Brand
  status          InstagramDraftStatus  @default(QUEUED)
  // Null until actually processed — unknown at queue time, and the
  // configured provider could change before this is picked up.
  aiProviderUsed  AiProvider?
  permalink       String?
  originalCaption String
  images          String[]

  // Set once a worker claims this row, so a crashed/killed run doesn't
  // leave it stuck forever — reclaimable after a staleness window.
  processingStartedAt DateTime?
  attempts            Int       @default(0)
  // Most recent failure, shown to the admin on a FAILED card.
  lastError           String?

  // Default "" until actually processed (see status comment above) —
  // never shown as a real value before then, the UI renders QUEUED/
  // FAILED cards without an edit form.
  title            String @default("")
  brandName        String?
  description      String @default("")
  // Pesewas, same convention as everywhere else — null if the AI couldn't
  // confidently read a price off the post.
  detectedPriceGhs Int?
  sizes            String[]
  color            String?
  missingFields    String[]

  // AI's best-guess category, pre-filled in the review form but always
  // editable/overridable before approval — never applied automatically.
  // Null if the AI found no confident match among this store's existing
  // categories. SetNull (not cascade) so deleting a category doesn't
  // destroy the draft, just clears the suggestion.
  suggestedCategoryId String?
  suggestedCategory   Category? @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)

  // Set once approved and a real Product exists for it.
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sourceAccount])
}

// ---------- Analytics ----------

// Minimal, anonymous page-view log for the admin dashboard's visitor
// stats. visitorId is a random id set once per browser via an httpOnly
// cookie in the storefront's proxy.ts — never tied to a name, email, or
// account, and nothing else about the request is recorded. brand is
// resolved server-side from the request's hostname/path at write time
// (see track-brand.ts) — a subdomain visit to "/" is really that brand's
// homepage even though the path alone wouldn't show it.
model PageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  brand     Brand?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}
