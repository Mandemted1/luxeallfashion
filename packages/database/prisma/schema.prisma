generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via PgBouncer) — what the app uses at runtime.
  // Serverless functions open lots of short-lived connections; pooling
  // keeps that from exhausting Postgres's connection limit.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection — migrations need this specifically,
  // they use features (advisory locks) that don't work through a pooler
  // in transaction mode.
  directUrl = env("DIRECT_URL")
}

// ---------- Admin / staff (apps/admin auth) ----------

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invitesSent AdminInvite[]
}

// Not a Better-Auth primitive — this is our own invite-only admin signup
// flow, sitting on top of it: the OWNER creates an invite, Resend emails
// the link, and accepting it is what creates the real AdminUser account.
// There's no public admin registration; this is the only way in.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  role        AdminRole @default(STAFF)
  token       String    @unique
  invitedById String
  invitedBy   AdminUser @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Auth (Better-Auth) ----------
//
// Two fully separate identity namespaces are required here, not one: a
// customer session must never be valid on the admin subdomain, and vice
// versa. AdminUser and Customer are the "user" identity for each side.
// Better-Auth also needs its own Session/Account/Verification-shaped
// tables per side — deliberately not hand-typed here. Those get generated
// with `npx @better-auth/cli generate` once the package is installed and
// configured (which apps use which plugins, e.g. 2FA on admin only), so
// they stay exactly in sync with the library's actual current schema
// instead of a guess made ahead of it.

// ---------- Catalog ----------

// The three sub-brands sold through the one shared storefront/cart/checkout.
// Kept separate from Category (what it is) so admin analytics can
// roll revenue, orders, and inventory up per brand (which store it's under).
enum Brand {
  OG_LUXEMEN
  CHICSTYLE
  KIDDIES_SPACE_GH
}

// Admin-defined and managed from the dashboard — not a fixed enum, so she
// can create/rename/delete categories herself with no code changes.
// Scoped to one of the three storefronts (Brand) — categories aren't
// shared across stores. She creates "under" a specific brand, e.g. OG
// Luxemen's "Shirts" is a separate row from a hypothetical Chicstyle
// "Shirts", not the same category reused across stores.
model Category {
  id        String   @id @default(cuid())
  brand     Brand
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([brand, slug])
  @@index([brand])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  material    String?
  brand       Brand
  // Must reference a Category with the same brand — Prisma can't enforce
  // that at the schema level, so the admin's product form should only
  // offer categories matching the product's own brand.
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([brand])
  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size      String // e.g. "M", "L", "XL", "2XL", "41".."46"
  colorName String
  colorHex  String
  sku       String @unique
  quantity  Int    @default(0)
  priceGhs  Int // stored in pesewas (minor unit) to avoid float math

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, colorName])
}

// ---------- Discounts ----------

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Editing an existing code's terms isn't offered in the admin UI on
// purpose — once a code may have been used on real orders, retroactively
// changing its value gets confusing. The flow is: deactivate old, add new.
model DiscountCode {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType
  value      Int // PERCENTAGE: 1-100. FIXED: pesewas.
  // Null = valid across all three stores. Set = scoped to one brand only.
  brand      Brand?
  isActive   Boolean      @default(true)
  usageLimit Int? // null = unlimited
  usageCount Int          @default(0)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders Order[]

  @@index([brand])
}

// ---------- Delivery ----------

model DeliveryRegion {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Greater Accra"
  slug      String   @unique // matches predefined region geometry on the map
  priceGhs  Int // stored in pesewas
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

// ---------- Customers & marketing ----------

// A Customer row is created on first checkout regardless of whether they
// create an account. passwordHash stays null for guest checkouts; setting
// a password (at checkout or later) is what turns a guest into a full
// account with login + order history + saved addresses.
model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique
  passwordHash   String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

model CustomerAddress {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label            String? // e.g. "Home", "Office"
  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  addressDetail    String
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

// ---------- Orders ----------

enum OrderStatus {
  PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  deliveryAddress  String // free-text detail within the chosen region

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)

  subtotalGhs Int
  shippingGhs Int
  totalGhs    Int

  // Amount actually deducted at checkout, kept even if the code's own
  // terms change or it's deleted later — same "value at time of purchase"
  // pattern as OrderItem.priceGhs below.
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountGhs    Int           @default(0)

  paystackReference String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusEvent[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int
  priceGhs Int // price at time of purchase, per unit
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}
