generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Admin / staff (apps/admin auth) ----------

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Catalog ----------

// The three sub-brands sold through the one shared storefront/cart/checkout.
// Kept separate from Category (what it is) so admin analytics can
// roll revenue, orders, and inventory up per brand (which store it's under).
enum Brand {
  OG_LUXEMEN
  CHICSTYLE
  KIDDIES_SPACE_GH
}

// Admin-defined and managed from the dashboard — not a fixed enum, so she
// can create/rename/delete categories herself with no code changes.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  material    String?
  brand       Brand
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  orderItems OrderItem[]

  @@index([brand])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  size      String // e.g. "M", "L", "XL", "2XL", "41".."46"
  colorName String
  colorHex  String
  sku       String  @unique
  quantity  Int     @default(0)
  priceGhs  Int // stored in pesewas (minor unit) to avoid float math

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, colorName])
}

// ---------- Delivery ----------

model DeliveryRegion {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Greater Accra"
  slug      String   @unique // matches predefined region geometry on the map
  priceGhs  Int // stored in pesewas
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

// ---------- Customers & marketing ----------

// A Customer row is created on first checkout regardless of whether they
// create an account. passwordHash stays null for guest checkouts; setting
// a password (at checkout or later) is what turns a guest into a full
// account with login + order history + saved addresses.
model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique
  passwordHash   String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
}

model CustomerAddress {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label            String? // e.g. "Home", "Office"
  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  addressDetail    String
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

// ---------- Orders ----------

enum OrderStatus {
  PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  deliveryRegionId String
  deliveryRegion   DeliveryRegion @relation(fields: [deliveryRegionId], references: [id])
  deliveryAddress  String // free-text detail within the chosen region

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)

  subtotalGhs Int
  shippingGhs Int
  totalGhs    Int

  paystackReference String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             OrderItem[]
  statusHistory     OrderStatusEvent[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity    Int
  priceGhs    Int // price at time of purchase, per unit
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}
